# LLM provider: openai | groq | openrouter | mistral | deepseek | gemini | anthropic | together
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=
# Provider-specific keys (used if LLM_API_KEY empty)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
# legacy fallback model name
OPENAI_MODEL=gpt-4o-mini

# Email (optional) - Resend
RESEND_API_KEY=
RESEND_FROM=Digest <digest@example.com>
RESEND_TO=you@example.com

# Cloudflare (used by GitHub Actions / wrangler)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PAGES_PROJECT_NAME=naija-news
