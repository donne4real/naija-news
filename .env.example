# LLM provider: openai | groq | openrouter | mistral | deepseek | gemini | anthropic | together
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=
# Provider-specific keys (used if LLM_API_KEY empty)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
# Ranking / dedup tuning
DEDUP_THRESHOLD=0.45
RANK_SOURCE_WEIGHT=2
RANK_RECENCY_HOURS=48
TOP_N=24
DIGEST_SIZE=15
MAX_PER_CATEGORY=3

# Email / Newsletter
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_SUBSCRIBE_URL=
RESEND_API_KEY=
RESEND_FROM=Digest <digest@example.com>
RESEND_TO=you@example.com

# Cloudflare (used by GitHub Actions / wrangler)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PAGES_PROJECT_NAME=naija-news
